# Cấu hình môi trường FastAPI
FASTAPI_ENV=development
PROJECT_NAME="Financial AI Analyst Assistant"

# Khóa bí mật JWT & phiên làm việc
SECRET_KEY=supersecretkeyforlocaldevonly123456789

# Tài khoản quản trị viên mặc định khởi tạo lần đầu
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Cấu hình Email kiểm thử qua Mailpit
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_TLS=false
EMAILS_FROM_EMAIL=info@example.com

# Cấu hình Cơ sở dữ liệu PostgreSQL
POSTGRES_PASSWORD=changethis
DATABASE_URL=postgresql://postgres:changethis@db:5432/app

# Cấu hình Domain & Frontend
DOMAIN=localhost
VITE_API_URL=http://localhost:8000

# Google Gemini API Key (điền API key của bạn vào đây)
GEMINI_API_KEY=
